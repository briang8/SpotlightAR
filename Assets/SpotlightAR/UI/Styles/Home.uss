/* Home and song setup screens (screens_v2.png, left; flowchart "Song setup"). */

.screen-root--opaque {
    background-color: var(--c-bg);
}

.cover {
    background-color: var(--c-surface-raised);
    -unity-background-scale-mode: scale-and-crop;
}

.text-button {
    margin: 0;
    padding: 8px 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--c-amber);
    font-size: 34px;
}

.text-button:hover,
.text-button:focus,
.text-button:active {
    background-color: rgba(0, 0, 0, 0);
    color: var(--c-amber);
}

.text-button--centered {
    align-self: center;
    margin-top: 18px;
    color: var(--c-muted);
}

/* ---------- Home header ---------- */

.home {
    padding-bottom: 0;
}

.home__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 20px;
}

.home__greeting {
    font-size: 34px;
    color: var(--c-muted);
}

.home__title {
    font-size: 76px;
    margin-top: -4px;
}

.avatar {
    width: 116px;
    height: 116px;
    border-radius: 58px;
    border-width: 4px;
    border-color: var(--c-amber);
    background-color: #2A2340;
    align-items: center;
    justify-content: center;
}

.avatar .icon {
    width: 52px;
    height: 52px;
    color: var(--c-amber);
}

/* ---------- Search ---------- */

.search {
    margin-top: 36px;
    height: 120px;
    border-radius: 60px;
    background-color: var(--c-surface-raised);
    flex-direction: row;
    align-items: center;
    padding-left: 40px;
}

.search__icon {
    width: 48px;
    height: 48px;
    color: var(--c-muted);
}

.search__field {
    flex-grow: 1;
    margin: 0 30px 0 16px;
    font-size: 38px;
}

.search__field > .unity-base-text-field__input,
.search__field > .unity-base-text-field__input:hover,
.search__field > .unity-base-text-field__input:focus {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--c-text);
    padding: 0;
    --unity-cursor-color: var(--c-amber);
    --unity-selection-color: rgba(255, 181, 71, 0.35);
}

.search__field .unity-text-element--placeholder {
    color: var(--c-muted);
}

/* ---------- Genre chips ---------- */

.chips {
    margin: 32px -44px 0 -44px;
    flex-shrink: 0;
}

.chips > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    flex-direction: row;
    padding: 0 44px;
}

.chip {
    height: 96px;
    margin: 0 18px 0 0;
    padding: 0 40px;
    border-radius: 48px;
    border-width: 3px;
    border-color: var(--c-border);
    background-color: rgba(0, 0, 0, 0);
    color: var(--c-text);
    font-size: 36px;
}

.chip:hover,
.chip:focus {
    border-color: var(--c-border);
    background-color: rgba(0, 0, 0, 0);
}

.chip--selected,
.chip--selected:hover,
.chip--selected:focus {
    border-color: var(--c-text);
    background-color: var(--c-text);
    color: var(--c-bg);
}

/* ---------- Scrolling content ---------- */

.home__scroll {
    flex-grow: 1;
    margin: 32px -44px 0 -44px;
}

.home__scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    padding: 0 44px 230px 44px;
}

.home__status {
    margin: 10px 0 20px 0;
    font-size: 32px;
    color: var(--c-muted);
    white-space: normal;
}

/* ---------- Featured card ---------- */

.featured {
    height: 590px;
    border-radius: 48px;
    overflow: hidden;
    background-color: var(--c-surface-raised);
    justify-content: space-between;
}

.featured__cover {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.featured__badge {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    margin: 36px 0 0 36px;
    padding: 14px 28px;
    border-radius: 40px;
    background-color: rgba(14, 15, 22, 0.88);
}

.featured__badge-dot {
    width: 16px;
    height: 16px;
    margin-right: 14px;
    border-radius: 8px;
    background-color: var(--c-danger);
}

.featured__badge-text {
    font-size: 28px;
    letter-spacing: 1px;
    color: var(--c-amber);
}

.featured__info {
    flex-direction: row;
    align-items: flex-end;
    padding: 40px 36px 36px 48px;
    background-color: rgba(32, 16, 32, 0.82);
}

.featured__text {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 24px;
}

.featured__title {
    font-size: 70px;
    white-space: normal;
    -unity-text-align: lower-left;
}

.featured__meta {
    margin-top: 6px;
    font-size: 34px;
    color: #E6DCEB;
}

.featured__sing {
    width: 156px;
    height: 156px;
    border-radius: 78px;
    flex-shrink: 0;
}

.dots {
    flex-direction: row;
    justify-content: center;
    margin-top: 26px;
    height: 14px;
}

.dot {
    width: 14px;
    height: 14px;
    margin: 0 7px;
    border-radius: 7px;
    background-color: var(--c-border);
    transition-property: width, background-color;
    transition-duration: 0.25s;
}

.dot--active {
    width: 52px;
    background-color: var(--c-text);
}

/* ---------- Search all of YouTube ---------- */

.search-online {
    flex-direction: row;
    align-items: center;
    height: 120px;
    margin: 8px 0 0 0;
    padding: 0 40px;
    border-radius: 60px;
    border-width: 3px;
    border-color: var(--c-amber);
    background-color: var(--c-amber-tint);
}

.search-online:hover,
.search-online:focus {
    border-color: var(--c-amber);
    background-color: var(--c-amber-tint);
}

.search-online:active {
    scale: 0.98 0.98;
}

.search-online .icon {
    width: 46px;
    height: 46px;
    margin-right: 22px;
    color: var(--c-amber);
}

.search-online__label {
    flex-shrink: 1;
    font-size: 36px;
    color: var(--c-amber);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* ---------- Song list ---------- */

.list-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin: 44px 0 16px 0;
}

.list-header__title {
    font-size: 50px;
}

.song-row {
    flex-direction: row;
    align-items: center;
    height: 168px;
    padding: 12px 0;
}

.song-row:active {
    opacity: 0.7;
}

.song-row__rank {
    width: 76px;
    font-size: 46px;
    -unity-text-align: middle-center;
}

.song-row__cover {
    width: 136px;
    height: 136px;
    margin: 0 30px 0 12px;
    border-radius: 24px;
    flex-shrink: 0;
}

.song-row__text {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.song-row__title,
.song-row__meta {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.song-row__title {
    font-size: 40px;
}

.song-row__meta {
    margin-top: 4px;
    font-size: 32px;
    color: var(--c-muted);
}

.song-row__duration {
    margin-left: 20px;
    font-size: 32px;
    color: var(--c-muted);
}

.skeleton-row {
    height: 136px;
    margin: 16px 0;
    border-radius: 24px;
    background-color: var(--c-surface-raised);
    opacity: 0.6;
}

/* ---------- Bottom navigation ---------- */

.nav {
    position: absolute;
    left: 44px;
    right: 44px;
    bottom: 40px;
    height: 160px;
    padding: 0 20px;
    border-radius: 80px;
    border-width: 2px;
    border-color: var(--c-border);
    background-color: #15161F;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.nav__item {
    height: 120px;
    min-width: 120px;
    margin: 0;
    padding: 0 30px;
    border-width: 0;
    border-radius: 60px;
    background-color: rgba(0, 0, 0, 0);
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.nav__item:hover,
.nav__item:focus {
    background-color: rgba(0, 0, 0, 0);
}

.nav__item .icon {
    width: 56px;
    height: 56px;
    color: var(--c-muted);
}

.nav__item--active,
.nav__item--active:hover,
.nav__item--active:focus {
    background-color: var(--c-text);
}

.nav__item--active .icon,
.nav__label {
    color: var(--c-bg);
}

.nav__label {
    margin-left: 14px;
    font-size: 36px;
}

.nav__item--soon {
    opacity: 0.45;
}

.nav__sing,
.nav__sing:hover,
.nav__sing:focus {
    width: 128px;
    min-width: 128px;
    padding: 0;
    background-color: var(--c-amber);
}

.nav__sing:active {
    background-color: var(--c-amber-pressed);
}

.nav__sing .icon {
    color: var(--c-on-amber);
}

/* ---------- Song setup ---------- */

.setup__heading {
    font-size: 40px;
}

.top-bar__spacer {
    width: 120px;
}

.setup__scroll {
    flex-grow: 1;
    margin: 20px -44px 0 -44px;
}

.setup__scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    padding: 0 44px 40px 44px;
}

.setup__song {
    flex-direction: row;
    align-items: center;
    margin-top: 20px;
}

.setup__cover {
    width: 240px;
    height: 240px;
    border-radius: 36px;
    flex-shrink: 0;
}

.setup__song-text {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 36px;
}

.setup__title {
    font-size: 58px;
    white-space: normal;
}

.setup__meta {
    margin-top: 8px;
    font-size: 32px;
    color: var(--c-muted);
    white-space: normal;
}

.section-title {
    margin: 56px 0 24px 0;
    font-size: 46px;
}

.stage-list {
    flex-direction: row;
    margin: 0 -10px;
}

.stage-card {
    flex-grow: 1;
    flex-basis: 0;
    height: 290px;
    margin: 0 10px;
    padding: 28px 24px;
    border-radius: 34px;
    border-width: 3px;
    border-color: var(--c-border);
    background-color: var(--c-surface-raised);
    align-items: flex-start;
    justify-content: flex-start;
    transition-property: border-color, scale;
    transition-duration: 0.15s;
}

.stage-card:hover,
.stage-card:focus {
    border-color: var(--c-border);
    background-color: var(--c-surface-raised);
}

.stage-card:active {
    scale: 0.97 0.97;
}

.stage-card--selected,
.stage-card--selected:hover,
.stage-card--selected:focus {
    border-color: var(--c-amber);
    background-color: var(--c-amber-tint);
}

.stage-card:disabled {
    opacity: 0.4;
}

.stage-card__swatch {
    width: 64px;
    height: 64px;
    border-radius: 20px;
    margin-bottom: 26px;
}

.stage-card__name {
    font-size: 36px;
}

.stage-card__tagline {
    margin-top: 8px;
    font-size: 27px;
    color: var(--c-muted);
    white-space: normal;
}

.mic-panel {
    padding: 36px 40px;
    border-radius: 36px;
    border-width: 3px;
    border-color: var(--c-border);
    background-color: var(--c-surface-raised);
}

.mic-panel__row {
    flex-direction: row;
    align-items: center;
}

.mic-panel__dot {
    width: 22px;
    height: 22px;
    margin-right: 18px;
    border-radius: 11px;
    background-color: var(--c-amber);
}

.mic-panel__status {
    font-size: 40px;
}

.mic-panel__meter {
    height: 96px;
    margin: 30px 0 24px 0;
}

.mic-panel__tip {
    font-size: 30px;
    color: var(--c-muted);
    white-space: normal;
}

.mic-panel--heard {
    border-color: var(--c-green);
}

.mic-panel--heard .mic-panel__dot {
    background-color: var(--c-green);
}

.mic-panel--heard .mic-panel__status {
    color: var(--c-green);
}

.mic-panel--help .mic-panel__dot {
    background-color: var(--c-danger);
}

.setup__actions {
    padding: 24px 0 52px 0;
}
