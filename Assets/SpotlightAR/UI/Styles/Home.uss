/* Home and song setup screens. */

.screen-root--opaque {
    background-color: var(--c-bg);
}

.cover {
    background-color: var(--c-fill);
    -unity-background-scale-mode: scale-and-crop;
}

/* ---------- Home header ---------- */

.home {
    padding-bottom: 0;
}

.home__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    margin-top: 28px;
}

.home__titles {
    flex-shrink: 1;
}

.home__greeting {
    font-size: 34px;
    color: var(--c-muted);
}

.home__title {
    margin-top: 4px;
    font-size: 104px;
    white-space: normal;
}

.home__theme {
    flex-shrink: 0;
    margin-top: 12px;
    margin-left: 24px;
}

/* ---------- Search ---------- */

.search {
    margin-top: 40px;
    height: 124px;
    border-radius: 62px;
    border-width: 1px;
    border-color: var(--c-border);
    background-color: var(--c-surface);
    flex-direction: row;
    align-items: center;
    padding-left: 42px;
}

.search__icon {
    width: 46px;
    height: 46px;
    color: var(--c-muted);
}

.search__field {
    flex-grow: 1;
    margin: 0 30px 0 18px;
    font-size: 38px;
}

.search__field > .unity-base-text-field__input,
.search__field > .unity-base-text-field__input:hover,
.search__field > .unity-base-text-field__input:focus {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--c-text);
    padding: 0;
    --unity-cursor-color: var(--c-accent);
    --unity-selection-color: rgba(140, 29, 64, 0.25);
}

.search__field .unity-text-element--placeholder {
    color: var(--c-muted);
}

/* ---------- Genre chips ---------- */

.chips {
    margin: 30px -52px 0 -52px;
    flex-shrink: 0;
}

.chips .unity-scroll-view__content-container {
    flex-direction: row;
    padding: 0 52px;
}

.chip {
    height: 96px;
    margin: 0 16px 0 0;
    padding: 0 42px;
    border-radius: 48px;
    border-width: 0;
    background-color: var(--c-fill);
    color: var(--c-text);
    font-size: 36px;
}

.chip:hover,
.chip:focus {
    background-color: var(--c-fill);
}

.chip--selected,
.chip--selected:hover,
.chip--selected:focus {
    background-color: var(--c-accent);
    color: var(--c-on-accent);
}

/* ---------- Scrolling content ---------- */

.home__scroll {
    flex-grow: 1;
    margin: 30px -52px 0 -52px;
}

.home__scroll .unity-scroll-view__content-container {
    padding: 0 52px 260px 52px;
}

.home__status {
    margin: 10px 0 20px 0;
    font-size: 32px;
    color: var(--c-muted);
    white-space: normal;
}

/* ---------- Featured card: cover art beside the song, like a music app ---------- */

.featured {
    flex-direction: row;
    align-items: center;
    padding: 36px;
    border-radius: 80px;
    border-width: 1px;
    border-color: var(--c-border);
    background-color: var(--c-surface);
}

.featured__cover {
    width: 330px;
    height: 330px;
    border-radius: 48px;
    flex-shrink: 0;
}

.featured__info {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 40px;
    overflow: hidden;
}

.featured__badge {
    color: var(--c-accent);
}

.featured__title {
    margin-top: 10px;
    font-size: 62px;
    white-space: normal;
}

.featured__meta {
    margin-top: 8px;
    font-size: 32px;
    color: var(--c-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.featured__sing {
    flex-direction: row;
    align-self: flex-start;
    align-items: center;
    height: 112px;
    margin: 28px 0 0 0;
    padding: 0 40px 0 30px;
    border-radius: 56px;
    border-width: 0;
    background-color: var(--c-accent);
    transition-property: scale;
    transition-duration: 0.12s;
}

.featured__sing:hover,
.featured__sing:focus {
    background-color: var(--c-accent);
}

.featured__sing:active {
    scale: 0.95 0.95;
    background-color: var(--c-accent-pressed);
}

.featured__sing .icon {
    width: 48px;
    height: 48px;
    color: var(--c-on-accent);
}

.featured__sing-label {
    margin-left: 14px;
    font-size: 36px;
    color: var(--c-on-accent);
}

.dots {
    flex-direction: row;
    justify-content: center;
    margin-top: 24px;
    height: 12px;
}

.dot {
    width: 12px;
    height: 12px;
    margin: 0 6px;
    border-radius: 6px;
    background-color: var(--c-border);
    transition-property: width, background-color;
    transition-duration: 0.25s;
}

.dot--active {
    width: 40px;
    background-color: var(--c-accent);
}

/* ---------- Search all of YouTube ---------- */

.search-online {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    height: 112px;
    margin: 16px 0 0 0;
    padding: 0 44px;
    border-radius: 56px;
    border-width: 0;
    background-color: var(--c-accent-tint);
}

.search-online:hover,
.search-online:focus {
    background-color: var(--c-accent-tint);
}

.search-online:active {
    scale: 0.98 0.98;
}

.search-online .icon {
    width: 44px;
    height: 44px;
    margin-right: 20px;
    color: var(--c-accent);
}

.search-online__label {
    flex-shrink: 1;
    font-size: 36px;
    color: var(--c-accent);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* ---------- Song list ---------- */

.list-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin: 52px 0 12px 0;
}

.list-header__title {
    font-size: 54px;
}

.song-row {
    flex-direction: row;
    align-items: center;
    height: 172px;
    padding: 14px 0;
}

.song-row:active {
    opacity: 0.6;
}

.song-row__rank {
    width: 64px;
    font-size: 34px;
    color: var(--c-muted);
    -unity-font-definition: url("../Fonts/InterDisplay-SemiBold-SDF.asset");
    -unity-text-align: middle-left;
}

.song-row__cover {
    width: 140px;
    height: 140px;
    margin: 0 32px 0 0;
    border-radius: 32px;
    flex-shrink: 0;
}

.song-row__text {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.song-row__title,
.song-row__meta {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.song-row__title {
    font-size: 40px;
}

.song-row__meta {
    margin-top: 4px;
    font-size: 32px;
    color: var(--c-muted);
}

.song-row__duration {
    margin-left: 20px;
    font-size: 32px;
    color: var(--c-muted);
}

.skeleton-row {
    height: 140px;
    margin: 16px 0;
    border-radius: 32px;
    background-color: var(--c-fill);
}

/* ---------- Bottom tab bar ---------- */

.nav {
    position: absolute;
    left: 52px;
    right: 52px;
    bottom: 40px;
    height: 168px;
    padding: 0 16px;
    border-radius: 84px;
    border-width: 1px;
    border-color: var(--c-border);
    background-color: var(--c-surface);
    flex-direction: row;
    align-items: center;
}

.nav__item {
    flex-grow: 1;
    flex-basis: 0;
    height: 136px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 68px;
    background-color: rgba(0, 0, 0, 0);
    align-items: center;
    justify-content: center;
}

.nav__item:hover,
.nav__item:focus {
    background-color: rgba(0, 0, 0, 0);
}

.nav__item .icon {
    width: 58px;
    height: 58px;
    color: var(--c-muted);
}

.nav__label {
    margin-top: 6px;
    font-size: 26px;
    color: var(--c-muted);
}

.nav__item--active .icon,
.nav__item--active .nav__label {
    color: var(--c-accent);
}

/* ---------- Song setup ---------- */

.setup__heading {
    font-size: 40px;
}

.top-bar__spacer {
    width: 104px;
}

.setup__scroll {
    flex-grow: 1;
    margin: 20px -52px 0 -52px;
}

.setup__scroll .unity-scroll-view__content-container {
    padding: 0 52px 40px 52px;
}

.setup__song {
    flex-direction: row;
    align-items: center;
    margin-top: 20px;
    padding: 32px;
    border-radius: 72px;
    border-width: 1px;
    border-color: var(--c-border);
    background-color: var(--c-surface);
}

.setup__cover {
    width: 230px;
    height: 230px;
    border-radius: 44px;
    flex-shrink: 0;
}

.setup__song-text {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 36px;
}

.setup__title {
    font-size: 56px;
    white-space: normal;
}

.setup__meta {
    margin-top: 6px;
    font-size: 32px;
    color: var(--c-muted);
    white-space: normal;
}

.setup__insights {
    align-self: flex-start;
    margin-top: 18px;
    padding: 12px 24px;
    border-radius: 32px;
    background-color: var(--c-accent-tint);
    color: var(--c-accent);
    font-size: 28px;
    white-space: normal;
}

.section-title {
    margin: 60px 0 26px 0;
    font-size: 50px;
}

.stage-list {
    flex-direction: row;
    margin: 0 -10px;
}

.stage-card {
    flex-grow: 1;
    flex-basis: 0;
    height: 300px;
    margin: 0 10px;
    padding: 24px;
    border-radius: 52px;
    border-width: 4px;
    border-color: var(--c-surface);
    background-color: var(--c-surface);
    align-items: flex-start;
    justify-content: flex-start;
    transition-property: border-color, scale;
    transition-duration: 0.15s;
}

.stage-card:hover,
.stage-card:focus {
    border-color: var(--c-surface);
    background-color: var(--c-surface);
}

.stage-card:active {
    scale: 0.97 0.97;
}

.stage-card--selected,
.stage-card--selected:hover,
.stage-card--selected:focus {
    border-color: var(--c-accent);
    background-color: var(--c-surface);
}

.stage-card:disabled {
    opacity: 0.4;
}

.stage-card__swatch {
    width: 96px;
    height: 96px;
    border-radius: 30px;
    margin-bottom: 24px;
}

.stage-card__name {
    font-size: 36px;
}

.stage-card__tagline {
    margin-top: 6px;
    font-size: 26px;
    color: var(--c-muted);
    white-space: normal;
}

.mic-panel {
    padding: 40px 44px;
    border-radius: 64px;
    border-width: 1px;
    border-color: var(--c-border);
    background-color: var(--c-surface);
}

.mic-panel__row {
    flex-direction: row;
    align-items: center;
}

.mic-panel__badge {
    width: 76px;
    height: 76px;
    margin-right: 24px;
    border-radius: 38px;
    background-color: var(--c-fill);
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.mic-panel__icon {
    width: 40px;
    height: 40px;
    color: var(--c-muted);
}

.mic-panel__status {
    flex-shrink: 1;
    font-size: 40px;
    white-space: normal;
}

.mic-panel__meter {
    height: 96px;
    margin: 30px 0 24px 0;
}

.mic-panel__tip {
    font-size: 30px;
    color: var(--c-muted);
    white-space: normal;
}

.mic-panel--heard .mic-panel__badge {
    background-color: var(--c-green);
}

.mic-panel--heard .mic-panel__icon {
    color: var(--c-on-green);
}

.mic-panel--heard .mic-panel__status {
    color: var(--c-green);
}

.mic-panel--help .mic-panel__badge {
    background-color: var(--c-danger-tint);
}

.mic-panel--help .mic-panel__icon {
    color: var(--c-danger);
}

.field-label {
    margin: 40px 0 16px 0;
    font-size: 32px;
    color: var(--c-muted);
}

.name-field {
    margin: 0;
    height: 120px;
    font-size: 42px;
}

.name-field > .unity-base-text-field__input,
.name-field > .unity-base-text-field__input:hover,
.name-field > .unity-base-text-field__input:focus {
    padding: 0 40px;
    border-radius: 40px;
    border-width: 1px;
    border-color: var(--c-border);
    background-color: var(--c-surface);
    color: var(--c-text);
    -unity-font-definition: url("../Fonts/InterDisplay-Bold-SDF.asset");
    --unity-cursor-color: var(--c-accent);
    --unity-selection-color: rgba(140, 29, 64, 0.25);
}

.name-field > .unity-base-text-field__input:focus {
    border-width: 3px;
    border-color: var(--c-accent);
}

.mic-panel__recheck {
    display: none;
    margin-top: 26px;
}

.mode-switch {
    margin-bottom: 18px;
}

.segment:disabled {
    opacity: 0.4;
}

.mode-caption {
    font-size: 30px;
    color: var(--c-muted);
    white-space: normal;
}

.setup__actions {
    padding: 28px 0 52px 0;
    align-items: center;
}

/* ---------- Tabs: Songs, Library, Stages ---------- */

.home__page {
    flex-grow: 1;
}

.page-header {
    margin-top: 28px;
}

/* Library */

.lib-stats {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 10px;
}

.lib-stat {
    width: 32%;
    padding: 28px 26px;
    border-radius: 40px;
    background-color: var(--c-fill);
}

.lib-stat__value {
    font-size: 60px;
}

.lib-stat__label {
    margin-top: 2px;
    font-size: 27px;
    color: var(--c-muted);
}

.lib-section {
    margin-top: 52px;
    margin-bottom: 6px;
}

.lib-row__score {
    margin-left: 20px;
    align-items: flex-end;
    flex-shrink: 0;
}

.lib-row__points {
    font-size: 38px;
}

.lib-row__stars {
    flex-direction: row;
    margin-top: 6px;
}

.lib-star {
    width: 28px;
    height: 28px;
    margin-left: 3px;
    color: var(--c-border);
}

.lib-star--on {
    color: var(--c-star);
}

.lib-footnote {
    margin-top: 30px;
    font-size: 28px;
    color: var(--c-muted);
    -unity-text-align: middle-center;
}

.empty {
    align-items: center;
    margin-top: 120px;
    padding: 0 40px;
}

.empty__badge {
    width: 180px;
    height: 180px;
    border-radius: 90px;
    background-color: var(--c-accent-tint);
    align-items: center;
    justify-content: center;
}

.empty__badge .icon {
    width: 84px;
    height: 84px;
    color: var(--c-accent);
}

.empty__title {
    margin-top: 40px;
    font-size: 56px;
}

.empty__body {
    margin: 16px 0 50px 0;
    font-size: 34px;
    color: var(--c-muted);
    white-space: normal;
    -unity-text-align: middle-center;
}

/* Stages */

.stage-tile {
    margin-top: 36px;
    border-radius: 56px;
    border-width: 4px;
    border-color: rgba(0, 0, 0, 0);
    background-color: var(--c-surface);
    overflow: hidden;
}

.stage-tile--selected {
    border-color: var(--c-accent);
}

.stage-tile__preview {
    height: 560px;
    -unity-background-scale-mode: scale-and-crop;
    opacity: 0.6;
    transition-property: opacity;
    transition-duration: 0.5s;
}

.stage-tile__preview--ready {
    opacity: 1;
}

.stage-tile__chip {
    position: absolute;
    left: 28px;
    top: 28px;
    flex-direction: row;
    align-items: center;
    padding: 10px 24px 10px 16px;
    border-radius: 30px;
    background-color: var(--c-accent);
    color: var(--c-on-accent);
}

.stage-tile__chip .icon {
    width: 32px;
    height: 32px;
    margin-right: 8px;
    color: var(--c-on-accent);
}

.stage-tile__info {
    padding: 34px 40px 40px 40px;
}

.stage-tile__name {
    font-size: 54px;
}

.stage-tile__tagline {
    margin-top: 6px;
    font-size: 32px;
    color: var(--c-muted);
    white-space: normal;
}

.stage-tile__meta {
    margin-top: 16px;
    font-size: 30px;
    color: var(--c-hi);
}

.stage-tile__button {
    align-self: flex-start;
    min-width: 0;
    height: 120px;
    margin-top: 28px;
    padding: 0 60px;
    font-size: 38px;
}

.sign-card {
    margin-top: 36px;
}

.swatches {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 8px;
}

.swatch {
    width: 104px;
    height: 104px;
    margin: 0 22px 18px 0;
    padding: 0;
    border-radius: 52px;
    border-width: 6px;
    border-color: var(--c-fill);
}

.swatch--selected {
    border-color: var(--c-text);
}

.swatch--auto {
    border-color: var(--c-border);
}

.swatch--auto.swatch--selected {
    border-color: var(--c-text);
}
