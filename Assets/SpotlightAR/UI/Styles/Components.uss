/* Reusable controls. Each button style restates :hover/:focus/:active so the
   default Unity theme's grey button states never leak through. */

/* ---------- Round icon buttons ---------- */

.round-button {
    width: 128px;
    height: 128px;
    margin: 0;
    padding: 0;
    border-radius: 64px;
    border-width: 1px;
    border-color: var(--c-border);
    background-color: var(--c-surface);
    align-items: center;
    justify-content: center;
    transition-property: scale;
    transition-duration: 0.12s;
}

.round-button:hover,
.round-button:focus {
    background-color: var(--c-surface);
    border-color: var(--c-border);
}

.round-button:active {
    scale: 0.92 0.92;
}

.round-button .icon {
    width: 54px;
    height: 54px;
    color: var(--c-text);
}

.round-button--small {
    width: 104px;
    height: 104px;
    border-radius: 52px;
}

.round-button--small .icon {
    width: 44px;
    height: 44px;
}

/* Over the camera: solid overlay instead of a white card with a border. */
.round-button--overlay,
.round-button--overlay:hover,
.round-button--overlay:focus {
    border-width: 0;
    background-color: var(--c-overlay);
}

.round-button--off .icon {
    color: var(--c-danger);
}

/* ---------- Text buttons: they hug their label instead of stretching edge to edge ---------- */

.primary-button {
    align-self: center;
    min-width: 520px;
    height: 150px;
    margin: 0;
    padding: 0 84px;
    border-radius: 75px;
    border-width: 0;
    background-color: var(--c-accent);
    color: var(--c-on-accent);
    font-size: 44px;
    -unity-font-definition: url("../Fonts/Inter-SemiBold-SDF.asset");
    -unity-text-align: middle-center;
    transition-property: scale, opacity;
    transition-duration: 0.12s;
}

.primary-button:hover,
.primary-button:focus {
    background-color: var(--c-accent);
    color: var(--c-on-accent);
}

.primary-button:active {
    scale: 0.97 0.97;
    background-color: var(--c-accent-pressed);
}

.primary-button:disabled {
    opacity: 0.35;
}

.secondary-button {
    align-self: center;
    height: 140px;
    margin: 0;
    padding: 0 72px;
    border-radius: 70px;
    border-width: 0;
    background-color: var(--c-fill);
    color: var(--c-text);
    font-size: 42px;
    -unity-font-definition: url("../Fonts/Inter-SemiBold-SDF.asset");
    -unity-text-align: middle-center;
    transition-property: scale;
    transition-duration: 0.12s;
}

.secondary-button:hover,
.secondary-button:focus {
    background-color: var(--c-fill);
    color: var(--c-text);
}

.secondary-button:active {
    scale: 0.97 0.97;
}

.text-button {
    margin: 0;
    padding: 8px 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--c-accent);
    font-size: 36px;
}

.text-button:hover,
.text-button:focus,
.text-button:active {
    background-color: rgba(0, 0, 0, 0);
    color: var(--c-accent);
}

.text-button--centered {
    align-self: center;
    margin-top: 22px;
    color: var(--c-muted);
}

.text-button--centered:hover,
.text-button--centered:focus,
.text-button--centered:active {
    color: var(--c-muted);
}

/* ---------- Segmented control (iOS style) ---------- */

.segmented {
    flex-direction: row;
    margin: 0 0 44px 0;
    padding: 8px;
    border-radius: 56px;
    background-color: var(--c-fill);
}

.segment {
    flex-grow: 1;
    flex-basis: 0;
    height: 104px;
    margin: 0;
    border-radius: 48px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--c-muted);
    font-size: 38px;
    -unity-text-align: middle-center;
    transition-property: background-color;
    transition-duration: 0.15s;
}

.segment:hover,
.segment:focus {
    background-color: rgba(0, 0, 0, 0);
    color: var(--c-muted);
}

.segment--selected,
.segment--selected:hover,
.segment--selected:focus {
    background-color: var(--c-surface);
    color: var(--c-text);
}

/* ---------- Status chip (placement) ---------- */

.status-chip {
    flex-direction: row;
    align-items: center;
    padding: 22px 38px;
    border-radius: 60px;
    background-color: var(--c-overlay);
}

.status-chip__dot {
    width: 20px;
    height: 20px;
    margin-right: 18px;
    border-radius: 10px;
    background-color: var(--c-hi);
}

.status-chip__label {
    font-size: 36px;
    color: var(--c-text);
}

.status-chip--found .status-chip__dot {
    background-color: var(--c-green);
}

/* ---------- Progress bar ---------- */

.progress {
    height: 10px;
    border-radius: 5px;
    background-color: var(--c-fill);
    overflow: hidden;
}

.progress__fill {
    width: 0;
    height: 100%;
    border-radius: 5px;
    background-color: var(--c-hi);
}

.voice-meter {
    flex-grow: 1;
    height: 72px;
}

/* ---------- Pills ---------- */

.pill {
    align-self: flex-start;
    padding: 12px 26px;
    border-radius: 40px;
    background-color: var(--c-accent-tint);
    color: var(--c-accent);
    font-size: 30px;
    -unity-font-definition: url("../Fonts/Inter-SemiBold-SDF.asset");
    white-space: normal;
}
