/* Reusable controls. Each button style restates :hover/:focus/:active so the
   default Unity theme's grey button states never leak through. */

.round-button {
    width: 150px;
    height: 150px;
    margin: 0;
    padding: 0;
    border-radius: 75px;
    border-width: 2px;
    border-color: var(--c-border);
    background-color: var(--c-surface-raised);
    align-items: center;
    justify-content: center;
    transition-property: scale, background-color;
    transition-duration: 0.12s;
}

.round-button:hover,
.round-button:focus {
    background-color: var(--c-surface-raised);
    border-color: var(--c-border);
}

.round-button:active {
    scale: 0.92 0.92;
    background-color: var(--c-border);
}

.round-button .icon {
    width: 64px;
    height: 64px;
    color: var(--c-text);
}

.round-button--small {
    width: 120px;
    height: 120px;
    border-radius: 60px;
    border-width: 0;
    background-color: var(--c-surface);
}

.round-button--small:hover,
.round-button--small:focus {
    background-color: var(--c-surface);
}

.round-button--small .icon {
    width: 52px;
    height: 52px;
}

.round-button--primary {
    width: 200px;
    height: 200px;
    border-radius: 100px;
    border-width: 0;
    background-color: var(--c-amber);
}

.round-button--primary:hover,
.round-button--primary:focus {
    background-color: var(--c-amber);
}

.round-button--primary:active {
    background-color: var(--c-amber-pressed);
}

.round-button--primary .icon {
    width: 76px;
    height: 76px;
    color: var(--c-on-amber);
}

.round-button--off .icon {
    color: var(--c-danger);
}

.primary-button {
    height: 150px;
    margin: 0;
    border-radius: 75px;
    border-width: 0;
    background-color: var(--c-amber);
    color: var(--c-on-amber);
    font-size: 46px;
    -unity-text-align: middle-center;
    transition-property: scale, opacity, background-color;
    transition-duration: 0.12s;
}

.primary-button:hover,
.primary-button:focus {
    background-color: var(--c-amber);
    color: var(--c-on-amber);
}

.primary-button:active {
    scale: 0.97 0.97;
    background-color: var(--c-amber-pressed);
}

.primary-button:disabled {
    opacity: 0.35;
}

.segmented {
    flex-direction: row;
    margin: 0 -8px 40px -8px;
}

.segment {
    flex-grow: 1;
    flex-basis: 0;
    height: 112px;
    margin: 0 8px;
    border-radius: 28px;
    border-width: 3px;
    border-color: var(--c-border);
    background-color: var(--c-surface-raised);
    color: var(--c-text);
    font-size: 38px;
    -unity-text-align: middle-center;
    transition-property: border-color, background-color;
    transition-duration: 0.15s;
}

.segment:hover,
.segment:focus {
    border-color: var(--c-border);
    background-color: var(--c-surface-raised);
}

.segment--selected,
.segment--selected:hover,
.segment--selected:focus {
    border-color: var(--c-amber);
    background-color: var(--c-amber-tint);
}

.status-chip {
    flex-direction: row;
    align-items: center;
    padding: 20px 36px;
    border-radius: 60px;
    background-color: var(--c-surface);
}

.status-chip__dot {
    width: 22px;
    height: 22px;
    margin-right: 16px;
    border-radius: 11px;
    background-color: var(--c-amber);
}

.status-chip__label {
    font-size: 36px;
    color: var(--c-amber);
}

.status-chip--found .status-chip__dot {
    background-color: var(--c-green);
}

.status-chip--found .status-chip__label {
    color: var(--c-green);
}

.progress {
    height: 10px;
    margin-top: 16px;
    border-radius: 5px;
    background-color: var(--c-border);
    overflow: hidden;
}

.progress__fill {
    width: 0;
    height: 100%;
    border-radius: 5px;
    background-color: var(--c-amber);
}

.voice-meter {
    flex-grow: 1;
    height: 72px;
}
