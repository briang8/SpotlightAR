/* Results card, shown over the AR view after the finale. */

.results {
    padding-bottom: 0;
}

.results__scroll {
    flex-grow: 0;
    flex-shrink: 1;
    margin: 0 -52px;
}

.results__card {
    padding: 60px 52px 64px 52px;
    border-top-left-radius: 80px;
    border-top-right-radius: 80px;
    background-color: var(--c-surface);
    align-items: stretch;
}

.results__headline {
    font-size: 96px;
    -unity-text-align: middle-center;
}

.results__song {
    margin-top: 4px;
    font-size: 32px;
    color: var(--c-muted);
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.results__stars {
    flex-direction: row;
    justify-content: center;
    margin: 32px 0 12px 0;
}

.results-star {
    width: 92px;
    height: 92px;
    margin: 0 10px;
    color: var(--c-border);
    scale: 0.85 0.85;
    /* Only scale animates: icons draw with the resolved colour, so a colour
       transition would freeze them on the starting colour. */
    transition-property: scale;
    transition-duration: 0.25s;
    transition-timing-function: ease-out-back;
}

.results-star--earned {
    color: var(--c-star);
    scale: 1 1;
}

.results__score {
    font-size: 150px;
    color: var(--c-hi);
    -unity-text-align: middle-center;
}

.results__badge {
    align-self: center;
    margin-top: 4px;
    padding: 10px 26px;
    border-radius: 30px;
    background-color: var(--c-green);
}

.results__badge-text {
    font-size: 24px;
    color: var(--c-on-green);
}

.results__best {
    margin-top: 10px;
    font-size: 30px;
    color: var(--c-muted);
    -unity-text-align: middle-center;
}

/* The crowd reaction row: an icon badge, a small label and one sentence. */
.note-row {
    flex-direction: row;
    align-items: flex-start;
    margin-top: 20px;
    padding: 28px 32px;
    border-radius: 44px;
    background-color: var(--c-fill);
}

.note-row__badge {
    width: 64px;
    height: 64px;
    margin-right: 26px;
    border-radius: 32px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background-color: var(--c-green);
}

.note-row__badge .icon {
    width: 36px;
    height: 36px;
    color: var(--c-on-green);
}

.note-row__text {
    flex-grow: 1;
    flex-shrink: 1;
}

.note-row__title {
    color: var(--c-green);
}

.note-row__body {
    margin-top: 4px;
    font-size: 31px;
    white-space: normal;
}


.results__actions {
    flex-direction: row;
    justify-content: center;
    margin-top: 40px;
}

.results__primary {
    min-width: 0;
    margin-right: 20px;
}

/* Praise row: green tint, the counterpart of the coral tip. */
.note-row--praise {
    background-color: var(--c-green-tint);
}

/* Cards for the skill bars and the pitch graph. */
.panel-card {
    margin-top: 20px;
    padding: 32px 36px 30px 36px;
    border-radius: 44px;
    background-color: var(--c-fill);
}

.panel-card__title {
    color: var(--c-muted);
    margin-bottom: 14px;
}

.graph-caption {
    margin-top: 8px;
    font-size: 25px;
    color: var(--c-muted);
    white-space: normal;
}
