/* Results card, shown over the AR view after the finale. */

.results {
    padding-bottom: 0;
}

.results__scroll {
    flex-grow: 0;
    flex-shrink: 1;
    margin: 0 -52px;
}

.results__card {
    padding: 60px 52px 64px 52px;
    border-top-left-radius: 80px;
    border-top-right-radius: 80px;
    background-color: var(--c-surface);
    align-items: stretch;
}

.results__headline {
    font-size: 96px;
    -unity-text-align: middle-center;
}

.results__song {
    margin-top: 4px;
    font-size: 32px;
    color: var(--c-muted);
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.results__stars {
    flex-direction: row;
    justify-content: center;
    margin: 32px 0 12px 0;
}

.results-star {
    width: 92px;
    height: 92px;
    margin: 0 10px;
    color: var(--c-border);
    scale: 0.85 0.85;
    /* Only scale animates: icons draw with the resolved colour, so a colour
       transition would freeze them on the starting colour. */
    transition-property: scale;
    transition-duration: 0.25s;
    transition-timing-function: ease-out-back;
}

.results-star--earned {
    color: var(--c-star);
    scale: 1 1;
}

.results__score {
    font-size: 150px;
    color: var(--c-hi);
    -unity-text-align: middle-center;
}

.results__badge {
    align-self: center;
    margin-top: 4px;
    padding: 10px 26px;
    border-radius: 30px;
    background-color: var(--c-green);
}

.results__badge-text {
    font-size: 24px;
    color: var(--c-on-green);
}

.results__best {
    margin-top: 10px;
    font-size: 30px;
    color: var(--c-muted);
    -unity-text-align: middle-center;
}

.stats {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-top: 36px;
}

/* One tile per stat: the tile carries the fill, so value and label sit on one surface. */
.stat {
    width: 48.8%;
    margin-bottom: 20px;
    padding: 26px 32px;
    border-radius: 40px;
    background-color: var(--c-fill);
}

.stat__value {
    font-size: 58px;
}

.stat__label {
    margin-top: 2px;
    font-size: 27px;
    color: var(--c-muted);
    white-space: normal;
}

/* Key result and coaching tip: quiet rows with an icon and a small label. */
.note-row {
    flex-direction: row;
    align-items: flex-start;
    margin-top: 20px;
    padding: 28px 32px;
    border-radius: 44px;
    background-color: var(--c-fill);
}

.note-row__badge {
    width: 64px;
    height: 64px;
    margin-right: 26px;
    border-radius: 32px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background-color: var(--c-green);
}

.note-row__badge .icon {
    width: 36px;
    height: 36px;
    color: var(--c-on-green);
}

.note-row__text {
    flex-grow: 1;
    flex-shrink: 1;
}

.note-row__title {
    color: var(--c-green);
}

.note-row__body {
    margin-top: 4px;
    font-size: 31px;
    white-space: normal;
}

.note-row--off .note-row__badge {
    background-color: var(--c-danger);
}

.note-row--off .note-row__title {
    color: var(--c-danger);
}

.note-row--unknown .note-row__badge {
    background-color: var(--c-border);
}

.note-row--unknown .note-row__badge .icon {
    color: var(--c-text);
}

.note-row--unknown .note-row__title {
    color: var(--c-muted);
}

.note-row--tip {
    background-color: var(--c-hi-tint);
}

.note-row--tip .note-row__badge {
    background-color: var(--c-hi);
}

.note-row--tip .note-row__badge .icon {
    color: var(--c-on-accent);
}

.note-row--tip .note-row__title {
    color: var(--c-hi);
}

.results__actions {
    flex-direction: row;
    justify-content: center;
    margin-top: 40px;
}

.results__primary {
    min-width: 0;
    margin-right: 20px;
}
