<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="results-root" class="screen-root results" picking-mode="Ignore">
        <ui:VisualElement class="spacer" picking-mode="Ignore" />
        <ui:ScrollView name="results-scroll" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" class="results__scroll">
            <ui:VisualElement name="results-card" class="results__card">
                <ui:Label name="results-headline" text="Encore!" class="results__headline heading" />
                <ui:Label name="results-song" text="Song title" class="results__song t-medium" />
                <ui:VisualElement name="results-stars" class="results__stars" />
                <ui:Label name="results-score" text="0" class="results__score heading" />
                <ui:VisualElement name="results-new-best" class="results__badge">
                    <ui:Label text="NEW BEST" class="results__badge-text t-caps" />
                </ui:VisualElement>
                <ui:Label name="results-best" text="Your best: 0" class="results__best t-medium" />
                <ui:VisualElement class="stats">
                    <ui:VisualElement class="stat">
                        <ui:Label name="stat-coverage" text="0%" class="stat__value heading--bold" />
                        <ui:Label text="of the song sung" class="stat__label" />
                    </ui:VisualElement>
                    <ui:VisualElement class="stat">
                        <ui:Label name="stat-note" text="0.0s" class="stat__value heading--bold" />
                        <ui:Label name="stat-note-label" text="longest steady note" class="stat__label" />
                    </ui:VisualElement>
                    <ui:VisualElement class="stat">
                        <ui:Label name="stat-pitch" text="–" class="stat__value heading--bold" />
                        <ui:Label name="stat-pitch-label" text="pitch steadiness" class="stat__label" />
                    </ui:VisualElement>
                    <ui:VisualElement class="stat">
                        <ui:Label name="stat-hype" text="x1" class="stat__value heading--bold" />
                        <ui:Label name="stat-hype-label" text="peak crowd hype" class="stat__label" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="results-key-row" class="note-row note-row--key">
                    <ui:VisualElement class="note-row__badge">
                        <SpotlightAR.UI.Icon name="results-key-icon" glyph="Check" />
                    </ui:VisualElement>
                    <ui:VisualElement class="note-row__text">
                        <ui:Label name="results-key-title" text="IN KEY" class="note-row__title t-caps" />
                        <ui:Label name="results-key" text="You sang in C minor." class="note-row__body" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="note-row note-row--tip">
                    <ui:VisualElement class="note-row__badge">
                        <SpotlightAR.UI.Icon glyph="StarFilled" />
                    </ui:VisualElement>
                    <ui:VisualElement class="note-row__text">
                        <ui:Label text="TIP" class="note-row__title t-caps" />
                        <ui:Label name="results-tip" text="Tip" class="note-row__body" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="results__actions">
                    <ui:Button name="sing-again-button" text="Sing again" class="primary-button results__primary" />
                    <ui:Button name="new-song-button" text="New song" class="secondary-button results__secondary" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
