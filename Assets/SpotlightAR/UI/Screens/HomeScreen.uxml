<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="home-root" class="screen-root screen-root--opaque home">
        <ui:VisualElement name="page-songs" class="home__page">
            <ui:VisualElement class="home__header">
                <ui:VisualElement class="home__titles">
                    <ui:Label name="greeting" text="Good evening" class="home__greeting t-semibold" />
                    <ui:Label text="What are we singing?" class="home__title heading" />
                </ui:VisualElement>
                <ui:Button name="theme-button" class="round-button round-button--small home__theme" tooltip="Light or dark mode">
                    <SpotlightAR.UI.Icon name="theme-icon" glyph="Moon" />
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement class="search">
                <SpotlightAR.UI.Icon glyph="Search" class="search__icon" />
                <ui:TextField name="search-field" class="search__field" />
            </ui:VisualElement>
            <ui:ScrollView name="genre-chips" mode="Horizontal" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" class="chips" />
            <ui:ScrollView name="home-scroll" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" class="home__scroll">
                <ui:VisualElement name="featured-card" class="featured">
                    <ui:VisualElement name="featured-cover" class="featured__cover cover" />
                    <ui:VisualElement class="featured__info">
                        <ui:Label text="TONIGHT'S PICK" class="featured__badge t-caps" />
                        <ui:Label name="featured-title" text="Golden Hour Drive" class="featured__title heading" />
                        <ui:Label name="featured-meta" text="The Lantern Kids · 3:42" class="featured__meta" />
                        <ui:Button name="featured-sing" class="featured__sing">
                            <SpotlightAR.UI.Icon glyph="Mic" />
                            <ui:Label text="Sing it" class="featured__sing-label t-semibold" />
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="featured-dots" class="dots" />
                <ui:Button name="search-online" class="search-online t-semibold">
                    <SpotlightAR.UI.Icon glyph="Search" />
                    <ui:Label name="search-online-label" text="Search YouTube" class="search-online__label" />
                </ui:Button>
                <ui:VisualElement class="list-header">
                    <ui:Label name="list-title" text="Top this week" class="list-header__title heading--bold" />
                    <ui:Button name="see-all" text="See all" class="text-button t-semibold" />
                </ui:VisualElement>
                <ui:Label name="home-status" text="Loading songs…" class="home__status" />
                <ui:VisualElement name="song-list" class="song-list" />
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement name="page-library" class="home__page">
            <ui:VisualElement class="page-header">
                <ui:Label text="Your shows" class="home__greeting t-semibold" />
                <ui:Label text="Library" class="home__title heading" />
            </ui:VisualElement>
            <ui:ScrollView name="library-scroll" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" class="home__scroll">
                <ui:VisualElement name="library-content" />
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement name="page-stages" class="home__page">
            <ui:VisualElement class="page-header">
                <ui:Label text="Where you perform" class="home__greeting t-semibold" />
                <ui:Label text="Stages" class="home__title heading" />
            </ui:VisualElement>
            <ui:ScrollView name="stages-scroll" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" class="home__scroll">
                <ui:VisualElement name="stages-content" />
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement class="nav">
            <ui:Button name="nav-home" class="nav__item nav__item--active">
                <SpotlightAR.UI.Icon glyph="Music" />
                <ui:Label text="Songs" class="nav__label t-semibold" />
            </ui:Button>
            <ui:Button name="nav-library" class="nav__item">
                <SpotlightAR.UI.Icon glyph="Library" />
                <ui:Label text="Library" class="nav__label t-semibold" />
            </ui:Button>
            <ui:Button name="nav-stages" class="nav__item">
                <SpotlightAR.UI.Icon glyph="Spotlight" />
                <ui:Label text="Stages" class="nav__label t-semibold" />
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
